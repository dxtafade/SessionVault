{
  "manifest_version": 3,
  "name": "Session Vault",
  "version": "0.1.0",
  "description": "Never lose your tabs again. Save, restore, and sync your browser sessions.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": ["https://rbsdtmjhhstqhqgddltu.supabase.co/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Session Vault — open the desk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
