{
  "manifest_version": 3,
  "name": "Session Vault",
  "version": "0.1.0",
  "description": "Never lose your tabs again. Save, restore, and sync your browser sessions.",
  "permissions": [
    "tabs",
    "sessions",
    "storage",
    "alarms"
  ],
  "host_permissions": ["https://rbsdtmjhhstqhqgddltu.supabase.co/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Session Vault — open the desk"
  }
}
